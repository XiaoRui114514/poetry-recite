{
  "name": "hison-poetry-recite",
  "version": "1.3.0",
  "private": true,
  "description": "上海初高古诗文背诵 · 初高中古诗文背诵学习系统（纯前端静态页面，Hison 制作）",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "build": "node build.js && node tools/check-dist.cjs",
    "test:unit": "node tests/unit.mjs",
    "test:data": "node tools/qa-data.cjs",
    "test:trans": "node tools/translations/verify.cjs",
    "trans:check": "node tools/translations/inject.cjs --check",
    "trans:inject": "node tools/translations/inject.cjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test": "npm run test:unit && npm run test:data && npm run test:trans && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
